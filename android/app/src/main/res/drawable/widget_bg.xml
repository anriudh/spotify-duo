<?xml version="1.0" encoding="utf-8"?>
<!-- Doubles as the card's outline: the root sets outlineProvider="background"
     and clipToOutline, so children (album art included) are clipped to these
     corners. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#1F1F23" />
    <corners android:radius="20dp" />
</shape>
